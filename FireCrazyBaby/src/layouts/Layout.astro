---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #1a1a2e;
        --muted: #5c5c70;
        --accent: #2c5aa0;
        --bg: #fbfbfd;
        --card: #ffffff;
        --border: #e4e4ec;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.6;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding: 2rem 1.5rem 1.5rem;
        text-align: center;
      }
      header h1 { margin: 0 0 0.4rem; font-size: 1.8rem; }
      header p { margin: 0; color: var(--muted); }
      header a { color: inherit; text-decoration: none; }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.85rem;
        padding: 2rem 1.5rem 3rem;
      }
      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <header>
      <h1><a href="/">AI &amp; Law Watch</a></h1>
      <p>Headlines on artificial intelligence and the law, curated by hand.</p>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Curated with a human in the loop. Posted automatically after approval on Telegram.
    </footer>
  </body>
</html>
